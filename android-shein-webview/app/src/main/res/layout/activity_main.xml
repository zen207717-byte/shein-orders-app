<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface" android:orientation="vertical" android:layoutDirection="rtl"
    android:fitsSystemWindows="true">

    <ProgressBar android:id="@+id/progressBar" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="4dp" android:max="100" android:visibility="gone" />

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">

        <WebView android:id="@+id/sheinWebView" android:layout_width="match_parent" android:layout_height="match_parent" />
        <WebView android:id="@+id/accountsWebView" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/saveFloatingButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal" android:layout_margin="14dp"
        android:text="إضافة لنظام أم مروان"
        android:textSize="13sp"
        app:backgroundTint="@color/brand"
        app:cornerRadius="24dp" />
    </FrameLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
        android:orientation="horizontal" android:paddingHorizontal="4dp" android:paddingVertical="2dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/tabShein"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:minHeight="44dp" android:insetTop="0dp" android:insetBottom="0dp"
            android:text="SHEIN" android:textSize="12sp" app:cornerRadius="10dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/tabAccounts"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="4dp" android:minHeight="44dp" android:insetTop="0dp" android:insetBottom="0dp"
            android:text="حسابات أم مروان" android:textSize="12sp" app:cornerRadius="10dp" />
    </LinearLayout>
</LinearLayout>
