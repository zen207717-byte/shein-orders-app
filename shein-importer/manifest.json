{
  "manifest_version": 3,
  "name": "مستورد SHEIN - حسابات أم مروان",
  "version": "0.1.0",
  "description": "ينقل بيانات القطعة الظاهرة من SHEIN إلى شاشة مراجعة داخل تطبيق حسابات أم مروان.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://shein.com/*",
    "https://*.shein.com/*",
    "https://shein-orders-app.onrender.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://shein.com/*", "https://*.shein.com/*"],
    "js": ["content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }]
}
